#!/usr/bin/env bash
# EXPERIMENT: run-observability
# sdlc-report launcher. Resolves the reporter relative to THIS script, exactly as sdlc-check
# resolves the checker, so it works on PATH from any working directory. Throwaway: removed with
# the rest of the experiment.
set -euo pipefail
src="${BASH_SOURCE[0]:-$0}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
exec node "$here/../checker/experiment-report.mjs" "$@"
